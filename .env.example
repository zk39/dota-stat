# 复制成 .env,填真实值。.env 不会被提交到 git。
DOTA_API_KEY=
OPENDOTA_API_KEY=
PORT=8000

# 以下都有默认值,一般不用填,公网访问量大/被刷了再调:
# DOTA_MIN_INTERVAL=1.1        # 出站调 Valve/OpenDota 的最小间隔(秒),全局共用一把锁
# DOTA_CACHE_TTL=600           # 玩家/搜索/战绩这类内存缓存的过期时间(秒)
# DOTA_RATE_LIMIT_PER_MIN=60   # 单 IP 每分钟最多能打多少次 /api/*(server.py 这层的第二道限速)
# DOTA_MAX_CONCURRENT=40       # 全局同时处理的请求数上限,超了直接 503(熔断)
# DOTA_CONCURRENCY_WAIT=2      # 抢并发名额的等待秒数,超时也是直接 503
